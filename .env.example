# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/prediq?schema=public"
# Direct / non-pooled URL for Prisma migrate (same as DATABASE_URL for local Postgres).
# On Neon/Vercel this is usually DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@127.0.0.1:5432/prediq?schema=public"

# Secrets — use long random values in production (required)
SESSION_SECRET="replace-with-long-random-string-at-least-32-chars"
CSRF_SECRET="replace-with-long-random-string-at-least-32-chars"

# Public site URL used for canonical links, sitemap, and cookies
APP_URL="http://127.0.0.1:3847"

# First administrator bootstrap (used only by npm run bootstrap-admin)
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-password"

# Optional sports data provider: API-Football (https://www.api-football.com / api-sports.io)
# Without this key, sync jobs will fail with a clear configuration error.
# Coverage, logo licensing, and commercial terms are defined by the provider.
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# Optional AI research assistance (never auto-publishes)
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

NODE_ENV="development"
